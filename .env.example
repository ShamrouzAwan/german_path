APP_ENV=development
SITE_NAME=GermanPath
SITE_URL=https://germanpath.site
DB_PATH=storage/database.sqlite
LOG_PATH=logs/application.log
ERROR_LOG_PATH=logs/error.log
AUTO_MIGRATE=true

# Keep secrets outside the repository.
ADMIN_EMAIL=admin@germanpath.site
WORKER_URL=
WORKER_SECRET=
WORKER_SIGN_PATH=/sign
WORKER_TIMEOUT_SECONDS=8
WORKER_TOKEN_TTL=300
MAIL_DRIVER=log
MAIL_FROM=no-reply@germanpath.site
VERIFICATION_TOKEN_TTL=86400
RESET_TOKEN_TTL=3600

SESSION_NAME=germanpath_session
SESSION_LIFETIME=7200
UPLOAD_MAX_BYTES=10485760
